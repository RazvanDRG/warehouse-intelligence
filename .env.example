# Copy to .env and fill in. Names only here; values never go in git.
# Any characters work in the password: the app builds the database URL and encodes it.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional overrides when the API runs outside Docker; unset means the local defaults
# (Postgres on localhost:5433, Redis on localhost:6379).
# DATABASE_URL=
# REDIS_URL=

# Kafka consumer for System 1 events.
# Required: a consumer group of its own for every deployment and every local run.
KAFKA_GROUP_ID=
# Optional: unset means a local broker on localhost:9092 with PLAINTEXT (no login).
# For Aiven set KAFKA_SECURITY_PROTOCOL=SASL_SSL; then username, password and the CA file path (ca.pem) are needed.
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_SECURITY_PROTOCOL=
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=
