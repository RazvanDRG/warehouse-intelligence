# Copy to .env and fill in. Names only here; values never go in git.
# Any characters work in the password: the app builds the database URL and encodes it.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional overrides when the API runs outside Docker; unset means the local defaults
# (Postgres on localhost:5433, Redis on localhost:6379).
# DATABASE_URL=
# REDIS_URL=
