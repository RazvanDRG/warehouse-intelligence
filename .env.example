# Copy to .env and fill in. Names only here; values never go in git.
# Any characters work in the password: the app builds the database URL and encodes it.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional overrides when the API runs outside Docker; unset means the local defaults
# (Postgres on localhost:5433, Redis on localhost:6379).
# DATABASE_URL=
# REDIS_URL=

# Kafka consumer for System 1 events. Unset means a local broker on localhost:9092 with PLAINTEXT.
# For Aiven: KAFKA_SECURITY_PROTOCOL=SASL_SSL, the WI principal's username and password, and the CA file path.
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_GROUP_ID=
# KAFKA_SECURITY_PROTOCOL=
# KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=
